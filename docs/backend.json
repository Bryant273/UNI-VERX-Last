
{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the application.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The user's full name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "avatarUrl": {
            "type": "string",
            "format": "uri",
            "description": "URL for the user's avatar image."
        },
        "role": {
          "type": "string",
          "description": "The role of the user within the application.",
          "enum": ["student", "professor", "academic-advisor", "admin"]
        }
      },
      "required": ["name", "email", "role"]
    },
    "StudentProfile": {
        "title": "Student Profile",
        "description": "Detailed profile for a student user.",
        "type": "object",
        "properties": {
            "user": { "$ref": "#/entities/User" },
            "studentId": { "type": "string" },
            "class": { "type": "string" },
            "level": { "type": "string" },
            "speciality": { "type": "string" }
        }
    },
    "ProfessorProfile": {
        "title": "Professor Profile",
        "description": "Detailed profile for a professor user.",
        "type": "object",
        "properties": {
            "user": { "$ref": "#/entities/User" },
            "title": { "type": "string" },
            "department": { "type": "string" },
            "office": { "type": "string" }
        }
    },
    "Course": {
      "title": "Course",
      "description": "An academic course or module.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "code": { "type": "string" },
        "description": { "type": "string" },
        "level": { "type": "string" },
        "class": { "type": "string" },
        "professorId": { "type": "string" }
      }
    },
    "CourseDocument": {
        "title": "Course Document",
        "description": "A document or resource related to a course.",
        "type": "object",
        "properties": {
            "courseId": { "type": "string" },
            "documentName": { "type": "string" },
            "documentType": { "type": "string", "enum": ["pdf", "docx", "pptx", "zip", "mp4"] },
            "fileUrl": { "type": "string", "format": "uri" },
            "uploadedAt": { "type": "string", "format": "date-time" },
            "uploaderId": { "type": "string" }
        }
    },
    "TimetableEvent": {
      "title": "Timetable Event",
      "description": "An event in the university schedule.",
      "type": "object",
      "properties": {
        "courseId": { "type": "string" },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" },
        "location": { "type": "string" },
        "type": { "type": "string", "enum": ["cours", "td", "tp", "examen", "activité"] },
        "class": { "type": "string" }
      }
    },
    "Report": {
        "title": "Report",
        "description": "A generated report (e.g., student performance, attendance).",
        "type": "object",
        "properties": {
            "reportType": { "type": "string" },
            "generatedAt": { "type": "string", "format": "date-time" },
            "generatedBy": { "type": "string" },
            "content": { "type": "object" }
        }
    }
  },
  "auth": {
    "providers": ["email"]
  },
  "firestore": {
    "/users/{userId}": {
        "schema": { "$ref": "#/entities/User" },
        "description": "Stores basic user account information."
    },
    "/studentProfiles/{userId}": {
        "schema": { "$ref": "#/entities/StudentProfile" },
        "description": "Stores detailed profiles for student users."
    },
    "/professorProfiles/{userId}": {
        "schema": { "$ref": "#/entities/ProfessorProfile" },
        "description": "Stores detailed profiles for professor users."
    },
    "/courses/{courseId}": {
      "schema": { "$ref": "#/entities/Course" },
      "description": "Collection of all available courses."
    },
    "/courses/{courseId}/documents/{documentId}": {
      "schema": { "$ref": "#/entities/CourseDocument" },
      "description": "Documents associated with a specific course."
    },
    "/timetable/{eventId}": {
      "schema": { "$ref": "#/entities/TimetableEvent" },
      "description": "All scheduled events for the university."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/Report" },
      "description": "Generated reports."
    }
  }
}
